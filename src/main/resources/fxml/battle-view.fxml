<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.Rectangle?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.game.battlesimulator.controller.BattleController">
    <!-- ENEMIES -->
    <HBox VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
        <VBox fx:id="enemyStatusContainer" alignment="TOP_LEFT" spacing="10">
            <Label fx:id="enemyNameLabel" text="INIMIGO"/>
            <Label fx:id="enemyHealthLabel" text="VIDA: 20/20"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox fx:id="enemySpritesContainer" alignment="TOP_RIGHT">
            <Rectangle width="60" height="60" fill="blue"/>
        </VBox>
    </HBox>

    <!-- PLAYER -->
    <HBox VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
        <VBox fx:id="playerSpriteContainer" alignment="BOTTOM_LEFT">
            <Rectangle width="60" height="60" fill="red"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox fx:id="playerStatusContainer" alignment="BOTTOM_RIGHT" spacing="10">
            <Label fx:id="playerNameLabel" text="SEU NOME"/>
            <Label fx:id="playerHealthLabel" text="VIDA: 20/20"/>
        </VBox>
    </HBox>

    <!-- BATTLE LOG & CONTROLS -->
    <HBox prefHeight="100" spacing="10" alignment="BOTTOM_CENTER">
        <ListView fx:id="battleLogView" HBox.hgrow="ALWAYS"/>

        <VBox alignment="BOTTOM_RIGHT">
            <Button fx:id="attackButton" text="Atacar" onAction="#handleButtonClick"/>
        </VBox>
    </HBox>
</VBox>
