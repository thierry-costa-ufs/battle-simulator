<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.game.battlesimulator.controller.BattleController"
           stylesheets="@../css/battle.css"
           styleClass="battle-container theme-yellow">

    <VBox alignment="CENTER"
          spacing="14">

        <HBox styleClass="turn-order-container" alignment="CENTER_LEFT" minHeight="44" maxHeight="44" spacing="10">
            <ScrollPane styleClass="turn-scroll" fitToHeight="true" fitToWidth="true" HBox.hgrow="ALWAYS">
                <HBox fx:id="turnOrderContainer" alignment="CENTER_LEFT" spacing="8"/>
            </ScrollPane>
            <Button text="Voltar ao Menu" styleClass="back-button" onAction="#handleBackToMenu"/>
        </HBox>

        <HBox fx:id="enemySpritesContainer" VBox.vgrow="ALWAYS" alignment="TOP_LEFT" spacing="16"/>

        <HBox fx:id="playerSpriteContainer" VBox.vgrow="ALWAYS" alignment="BOTTOM_RIGHT" spacing="16"/>

        <HBox prefHeight="120" spacing="10" alignment="BOTTOM_CENTER">
            <ListView fx:id="battleLogView" HBox.hgrow="ALWAYS" styleClass="battle-log" prefHeight="120" minHeight="120"/>

            <VBox fx:id="controlsContainer" styleClass="controls-container" alignment="CENTER" prefHeight="120" minHeight="120" prefWidth="250">
                <Button fx:id="attackButton" text="Atacar" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS" onAction="#handleButtonClick"/>
            </VBox>
        </HBox>

    </VBox>

    <StackPane fx:id="overlayRoot" styleClass="overlay-root" visible="false">
    </StackPane>
</StackPane>
